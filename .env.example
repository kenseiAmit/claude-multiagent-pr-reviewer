# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-your-api-key

# GitHub Personal Access Token (read-only repo/PR scope for GitHub MCP Server)
GITHUB_TOKEN=ghp_your_github_readonly_token

# Workspace Root for ESLint & Filesystem Scope
PROJECT_ROOT=/absolute/path/to/claude-multiagent-pr-reviewer

# Optional Rate Limit & Timeout Overrides
MAX_REQUESTS_PER_MINUTE=50
MAX_TOKENS_PER_MINUTE=100000
MAX_CONCURRENT_REQUESTS=5
REVIEW_TIMEOUT_MS=900000
